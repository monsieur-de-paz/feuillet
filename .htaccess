Options -Indexes
<FilesMatch "^(config\.php|.*\.(sqlite|db|json|md|lock))$">
Require all denied
</FilesMatch>

# Defense in depth against accidental FTP copies of secrets and repository metadata.
<FilesMatch "(?i)(^\.|~$|\.(bak|old|orig|swp|swo|sql|sqlite|db|log|ini|pem|key|p12|pfx)(\.gz)?$|^config\.php([.~_-].*)?$)">
    Require all denied
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 "(?i)(^|/)\.(git|svn|hg)(/|$)"
</IfModule>
