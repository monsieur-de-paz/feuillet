Options -Indexes
# Apache/OVH must serve ES modules and WebAssembly with explicit MIME types.
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType application/wasm .wasm
    AddType text/css .css
</IfModule>

# Defense in depth against accidental FTP copies of secrets and repository metadata.
<FilesMatch "(?i)(^\.|~$|\.(bak|old|orig|swp|swo|sql|sqlite|db|log|ini|pem|key|p12|pfx)(\.gz)?$|^config\.php([.~_-].*)?$)">
    Require all denied
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 "(?i)(^|/)\.(git|svn|hg)(/|$)"
</IfModule>
